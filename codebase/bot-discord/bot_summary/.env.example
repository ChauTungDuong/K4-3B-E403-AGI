DISCORD_BOT_TOKEN=your_discord_bot_token
GEMINI_API_KEY=your_gemini_api_key

# === KẾT NỐI DỊCH VỤ ===
# DISCORD_BOT_TOKEN ở trên: token đăng nhập Discord bot; phải giữ bí mật.
# GEMINI_API_KEY ở trên: API key dùng để gọi Gemini; phải giữ bí mật.
# Model Gemini dùng để phân tích. Model mạnh hơn thường chính xác hơn nhưng chậm/tốn hơn.
GEMINI_MODEL=gemini-3.5-flash-lite

# ID server phát triển để slash command đồng bộ gần như ngay lập tức.
# Để trống nếu muốn đồng bộ command global cho mọi server (có thể mất thời gian cập nhật).
DISCORD_GUILD_ID=

# === LƯU TRỮ VÀ GIỚI HẠN ĐẦU VÀO ===
# File SQLite lưu cấu hình server và snapshot xu hướng đã ẩn danh.
DATABASE_PATH=bot.db

# Số tin tối đa được đọc từ mỗi kênh trong một cửa sổ phân tích.
MAX_MESSAGES_PER_CHANNEL=500

# Số tin tối đa của toàn bộ kênh trong một lượt chạy.
MAX_TOTAL_MESSAGES=1000

# Tổng số ký tự tối đa trước khi gửi sang Gemini; giúp kiểm soát token và chi phí.
MAX_INPUT_CHARACTERS=200000

# true: đọc text từ bot/app khác; false: chỉ đọc tin người dùng.
# Tin của chính Bot Summary luôn bị bỏ qua để tránh vòng lặp báo cáo.
INCLUDE_BOT_MESSAGES=false

# Mức log ứng dụng: DEBUG, INFO, WARNING, ERROR hoặc CRITICAL.
LOG_LEVEL=INFO

# Ghi JSONL prompt đã ẩn danh và phản hồi thô để audit kỹ thuật.
# Không commit file trace vì có thể chứa nội dung hội thoại đã đưa vào model.
AI_TRACE_ENABLED=true
AI_TRACE_PATH=logs/ai_traces.jsonl


# === PIPELINE SUMMARY ===
# Số giờ mặc định của /summary khi người dùng không truyền tham số hours (1-168).
SUMMARY_DEFAULT_HOURS=24

# Confidence tối thiểu để task được xem là chắc chắn, nhận giá trị từ 0 đến 1.
# Từ 0.5 đến dưới ngưỡng này sẽ thành needs_confirmation; dưới 0.5 bị loại.
MIN_TASK_CONFIDENCE=0.75

# === PIPELINE TRENDS ===
# Số giờ hiện tại mặc định được dùng để tìm xu hướng (1-168).
TREND_CURRENT_HOURS=24

# Số ngày lịch sử dùng làm baseline để so sánh hot/new/rising (1-30).
TREND_BASELINE_DAYS=7

# Số tin tối thiểu của một topic trước khi có thể kết luận xu hướng.
MIN_TOPIC_MESSAGES=3

# Số người tham gia ẩn danh tối thiểu; giúp một người spam không tạo trend giả.
MIN_TOPIC_PARTICIPANTS=2

# Ngưỡng hot_score từ 0 đến 1 để topic được phân loại là hot.
HOT_SCORE_THRESHOLD=0.70
